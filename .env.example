# ── 微信推送配置 (三选一即可) ─────────────────────────────
# 1. 企业微信群机器人 Webhook (推荐: 企微群右上角添加机器人获取 Webhook 地址)
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# 2. PushPlus 推送加 Token (微信公众号接收: https://www.pushplus.plus/)
# PUSHPLUS_TOKEN=your_pushplus_token

# 3. Server酱 Turbo SendKey (https://sct.ftqq.com/)
# SERVERCHAN_KEY=your_serverchan_sendkey

# ── 静态看板 URL (GitHub Pages 部署地址) ──────────────────
DASHBOARD_URL=https://whatever5774.github.io/Project_001_gaspricetracker2026/

# ── 可选：Gmail SMTP 邮件配置 ─────────────────────────────
# GMAIL_ADDRESS=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
# REPORT_TO_EMAIL=recipient@example.com
